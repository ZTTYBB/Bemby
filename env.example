# Admin login credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# JWT signing secret -- REQUIRED. Generate a unique value, e.g. `openssl rand -hex 32`.
# The app refuses to start if this is unset or left at a known placeholder.
JWT_SECRET=

# Optional: timezone for scheduled jobs (defaults to UTC)
# TZ=Australia/Sydney

# Optional: override the listen port (defaults to 3000)
# PORT=3000

# Optional: override the SQLite database path (defaults to /app/data/bemby.db)
# DB_PATH=/app/data/bemby.db

# Optional: enable bulk account management (disabled by default).
# Set to 1 (or true) to show the "Bulk Add" and "Bulk Clean" buttons and enable
# their API routes.
# BULK_ACCOUNT_MANAGEMENT=1

# Optional: number of reverse proxy hops in front of this app (defaults to 0)
# Set to 1 if behind nginx/Caddy/Traefik, 2 if behind Cloudflare + nginx, etc.
# Required for rate limiting to work correctly when behind a proxy.
# TRUST_PROXY=1

# ── Memory bounds (matter on a small host, e.g. 2GB) ──────────────────────────
# Each connected Telegram account costs several MB of client state plus a socket.
# Clients nobody is watching are evicted once there are more than this many.
# TG_LIVE_CLIENT_MAX=8

# Inline chat media is buffered whole to serve it, so a large video spikes memory
# by its full size. Anything bigger than this is refused. (MB)
# TG_MEDIA_MAX_MB=25

# Outgoing file uploads are held in memory for the duration of the send. (MB)
# TG_UPLOAD_MAX_MB=50

# How often memory is sampled and persisted, in seconds. The watermark is what survives
# an OOM kill, so a longer interval means a staler final reading.
# MEMORY_SAMPLE_SECONDS=30

# Warn in the log once RSS passes this share of the limit, naming the job in flight.
# MEMORY_WARN_PERCENT=75

# V8 heap ceiling. The image sets --max-old-space-size=512, which suits a 2GB host;
# raise it on a bigger one. Overriding this variable replaces the image default, so
# repeat any other flags you need.
# NODE_OPTIONS=--max-old-space-size=1024

# Optional: CloakBrowser licence key for the Cloudflare solver's browser. Without one it
# runs the older free build, which passes fewer challenges as detection moves on; a free
# key (one per GitHub account, from https://cloakbrowser.dev/free) gets the current build.
# Set here it applies to every browser at once, which is only right for a paid key -- a
# free key allows one concurrent session. For free keys, add them in Settings instead,
# where one is leased per running browser.
# CLOAKBROWSER_LICENSE_KEY=cb_xxxxxxxx

# Optional: launch a Chromium already on the host instead of downloading the stealth one.
# It gives up the fingerprint patches, so it is for local development only.
# CLOAKBROWSER_BINARY_PATH=/usr/bin/chromium
